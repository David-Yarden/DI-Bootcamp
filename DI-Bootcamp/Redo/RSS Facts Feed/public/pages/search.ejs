<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/header') %>

    <div class="container mb-5">
      <h1 class="text-center fw-bold mb-1">Search Facts</h1>
      <p class="text-center text-muted">Find posts by title or category</p>

      <div class="row g-4 mt-2">

        <!-- Search by Title -->
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title">🔍 Search by Title</h5>
              <form action="/search/title" method="POST">
                <div class="mb-3">
                  <label for="title" class="form-label">Enter a keyword</label>
                  <input
                    type="text"
                    class="form-control"
                    id="title"
                    name="title"
                    placeholder="e.g. animals, space, history..."
                    required
                  />
                </div>
                <button type="submit" class="btn btn-primary w-100">Search</button>
              </form>
            </div>
          </div>
        </div>

        <!-- Search by Category -->
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title">🏷️ Search by Category</h5>
              <form action="/search/category" method="POST">
                <div class="mb-3">
                  <label for="category" class="form-label">Select a category</label>
                  <select class="form-select" id="category" name="category" required>
                    <option value="" disabled selected>-- Choose a category --</option>
                    <% if (typeof categories !== 'undefined' && categories) { %>
                      <% categories.forEach(cat => { %>
                        <option value="<%= cat %>"><%= cat %></option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>
                <button type="submit" class="btn btn-success w-100">Filter</button>
              </form>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Results -->
    <% if (typeof searchType !== 'undefined' && searchType) { %>
      <div class="container mb-3">
        <h4 class="text-muted">
          Results for
          <% if (searchType === 'title') { %>
            title: "<strong><%= query %></strong>"
          <% } else { %>
            category: "<strong><%= query %></strong>"
          <% } %>
          (<%= posts ? posts.length : 0 %> found)
        </h4>
      </div>
    <% } %>

    <%- include('../partials/posts', { posts: typeof posts !== 'undefined' ? posts : null }) %>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

PORT=5000
NODE_ENV=development

# Database - Update these with your PostgreSQL credentials
DATABASE_URL=postgresql://username:password@localhost:5432/storytelling_db

# JWT Secrets - Generate secure random strings for production!
JWT_SECRET=your_jwt_secret_key_change_in_production
REFRESH_SECRET=your_refresh_secret_key_change_in_production

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
